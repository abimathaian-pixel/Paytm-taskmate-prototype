# Server Configuration
PORT=4000
WEB_PORT=3000
NODE_ENV=development

# Database
# If empty or not set, TaskMate automatically uses high-performance embedded PGlite
# For Docker or production: postgresql://postgres:postgres@localhost:5432/taskmate
DATABASE_URL=

# AI Provider (Optional: TaskMate includes an offline deterministic tool orchestrator fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Inngest Workflow Configuration
INNGEST_EVENT_KEY=taskmate_dev_key
INNGEST_SIGNING_KEY=taskmate_signing_key

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
